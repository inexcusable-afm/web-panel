{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-panel",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b6cc7c3b-fd9b-4313-862a-f864dbdd83a4","database_name": "web-panel" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "7e344baf386f4d21b85e29c95089be4f" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
